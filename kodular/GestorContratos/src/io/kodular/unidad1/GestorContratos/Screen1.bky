<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="global_declaration" id="gEncontrado" x="20" y="20">
    <field name="NAME">encontrado</field>
    <value name="VALUE">
      <block type="logic_boolean" id="gF">
        <field name="BOOL">FALSE</field>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="gClave" x="20" y="80">
    <field name="NAME">claveEncontrada</field>
    <value name="VALUE">
      <block type="text" id="gC">
        <field name="TEXT"></field>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="gEmail" x="20" y="140">
    <field name="NAME">emailEncontrado</field>
    <value name="VALUE">
      <block type="text" id="gE">
        <field name="TEXT"></field>
      </block>
    </value>
  </block>

  <block type="component_event" id="evReg" x="20" y="220">
    <mutation component_type="Button" is_generic="false" instance_name="BotonIrRegistro" event_name="Click"></mutation>
    <field name="COMPONENT_SELECTOR">BotonIrRegistro</field>
    <statement name="DO">
      <block type="controls_openAnotherScreen" id="opReg">
        <value name="SCREEN">
          <block type="text" id="tReg">
            <field name="TEXT">ScreenRegistro</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="component_event" id="evShowRec" x="20" y="340">
    <mutation component_type="Button" is_generic="false" instance_name="BotonMostrarRecuperar" event_name="Click"></mutation>
    <field name="COMPONENT_SELECTOR">BotonMostrarRecuperar</field>
    <statement name="DO">
      <block type="component_set_get" id="setVis">
        <mutation component_type="VerticalArrangement" set_or_get="set" property_name="Visible" is_generic="false" instance_name="CajaRecuperar"></mutation>
        <field name="COMPONENT_SELECTOR">CajaRecuperar</field>
        <field name="PROP">Visible</field>
        <value name="VALUE">
          <block type="logic_boolean" id="vTrue">
            <field name="BOOL">TRUE</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="component_event" id="evEntrar" x="20" y="480">
    <mutation component_type="Button" is_generic="false" instance_name="BotonEntrar" event_name="Click"></mutation>
    <field name="COMPONENT_SELECTOR">BotonEntrar</field>
    <statement name="DO">
      <block type="controls_if" id="ifVacios">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="orV">
            <field name="OP">OR</field>
            <value name="A">
              <block type="text_isEmpty" id="eU">
                <value name="VALUE">
                  <block type="component_set_get" id="gU">
                    <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoUsuario"></mutation>
                    <field name="COMPONENT_SELECTOR">CampoUsuario</field>
                    <field name="PROP">Text</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="text_isEmpty" id="eC">
                <value name="VALUE">
                  <block type="component_set_get" id="gC2">
                    <mutation component_type="PasswordTextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoClave"></mutation>
                    <field name="COMPONENT_SELECTOR">CampoClave</field>
                    <field name="PROP">Text</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="component_method" id="al1">
            <mutation component_type="Notifier" method_name="ShowAlert" is_generic="false" instance_name="Notificador">
              <arg name="notice"></arg>
            </mutation>
            <field name="COMPONENT_SELECTOR">Notificador</field>
            <value name="ARG0">
              <block type="text" id="m1">
                <field name="TEXT">Digite usuario y clave</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="lexical_variable_set" id="setF">
            <field name="VAR">global encontrado</field>
            <value name="VALUE">
              <block type="logic_boolean" id="bf">
                <field name="BOOL">FALSE</field>
              </block>
            </value>
            <next>
              <block type="controls_forEach" id="forU">
                <field name="VAR">usuario</field>
                <value name="LIST">
                  <block type="component_method" id="getUs">
                    <mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1">
                      <arg name="tag"></arg>
                      <arg name="valueIfTagNotThere"></arg>
                    </mutation>
                    <field name="COMPONENT_SELECTOR">TinyDB1</field>
                    <value name="ARG0">
                      <block type="text" id="tUs">
                        <field name="TEXT">usuarios</field>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="lists_create_with" id="empty1">
                        <mutation items="0"></mutation>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="controls_if" id="ifUser">
                    <value name="IF0">
                      <block type="logic_operation" id="and1">
                        <field name="OP">AND</field>
                        <value name="A">
                          <block type="logic_compare" id="eqU">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="lists_select_item" id="i1">
                                <value name="LIST">
                                  <block type="lexical_variable_get" id="gu">
                                    <field name="VAR">usuario</field>
                                  </block>
                                </value>
                                <value name="NUM">
                                  <block type="math_number" id="n1">
                                    <field name="NUM">1</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="component_set_get" id="gU2">
                                <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoUsuario"></mutation>
                                <field name="COMPONENT_SELECTOR">CampoUsuario</field>
                                <field name="PROP">Text</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="eqC">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="lists_select_item" id="i2">
                                <value name="LIST">
                                  <block type="lexical_variable_get" id="gu2">
                                    <field name="VAR">usuario</field>
                                  </block>
                                </value>
                                <value name="NUM">
                                  <block type="math_number" id="n2">
                                    <field name="NUM">2</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="component_set_get" id="gCl">
                                <mutation component_type="PasswordTextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoClave"></mutation>
                                <field name="COMPONENT_SELECTOR">CampoClave</field>
                                <field name="PROP">Text</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="lexical_variable_set" id="setT">
                        <field name="VAR">global encontrado</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="bt">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                        <next>
                          <block type="component_method" id="saveSes">
                            <mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1">
                              <arg name="tag"></arg>
                              <arg name="valueToStore"></arg>
                            </mutation>
                            <field name="COMPONENT_SELECTOR">TinyDB1</field>
                            <value name="ARG0">
                              <block type="text" id="tSes">
                                <field name="TEXT">sesion</field>
                              </block>
                            </value>
                            <value name="ARG1">
                              <block type="component_set_get" id="gU3">
                                <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoUsuario"></mutation>
                                <field name="COMPONENT_SELECTOR">CampoUsuario</field>
                                <field name="PROP">Text</field>
                              </block>
                            </value>
                            <next>
                              <block type="controls_openAnotherScreen" id="opMenu">
                                <value name="SCREEN">
                                  <block type="text" id="tMenu">
                                    <field name="TEXT">ScreenMenu</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="ifNo">
                    <value name="IF0">
                      <block type="logic_negate" id="notE">
                        <value name="BOOL">
                          <block type="lexical_variable_get" id="gEnc">
                            <field name="VAR">global encontrado</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="component_method" id="al2">
                        <mutation component_type="Notifier" method_name="ShowAlert" is_generic="false" instance_name="Notificador">
                          <arg name="notice"></arg>
                        </mutation>
                        <field name="COMPONENT_SELECTOR">Notificador</field>
                        <value name="ARG0">
                          <block type="text" id="m2">
                            <field name="TEXT">Usuario o clave incorrectos</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="component_event" id="evEnviar" x="620" y="220">
    <mutation component_type="Button" is_generic="false" instance_name="BotonEnviarClave" event_name="Click"></mutation>
    <field name="COMPONENT_SELECTOR">BotonEnviarClave</field>
    <statement name="DO">
      <block type="lexical_variable_set" id="setC0">
        <field name="VAR">global claveEncontrada</field>
        <value name="VALUE">
          <block type="text" id="t0">
            <field name="TEXT"></field>
          </block>
        </value>
        <next>
          <block type="lexical_variable_set" id="setE0">
            <field name="VAR">global emailEncontrado</field>
            <value name="VALUE">
              <block type="text" id="t00">
                <field name="TEXT"></field>
              </block>
            </value>
            <next>
              <block type="controls_forEach" id="forE">
                <field name="VAR">usuario</field>
                <value name="LIST">
                  <block type="component_method" id="getUs2">
                    <mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1">
                      <arg name="tag"></arg>
                      <arg name="valueIfTagNotThere"></arg>
                    </mutation>
                    <field name="COMPONENT_SELECTOR">TinyDB1</field>
                    <value name="ARG0">
                      <block type="text" id="tUs2">
                        <field name="TEXT">usuarios</field>
                      </block>
                    </value>
                    <value name="ARG1">
                      <block type="lists_create_with" id="empty2">
                        <mutation items="0"></mutation>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO">
                  <block type="controls_if" id="ifMail">
                    <value name="IF0">
                      <block type="logic_compare" id="eqM">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="lists_select_item" id="i4">
                            <value name="LIST">
                              <block type="lexical_variable_get" id="gu3">
                                <field name="VAR">usuario</field>
                              </block>
                            </value>
                            <value name="NUM">
                              <block type="math_number" id="n4">
                                <field name="NUM">4</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="component_set_get" id="gMail">
                            <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="CampoEmailRecuperar"></mutation>
                            <field name="COMPONENT_SELECTOR">CampoEmailRecuperar</field>
                            <field name="PROP">Text</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="lexical_variable_set" id="setC1">
                        <field name="VAR">global claveEncontrada</field>
                        <value name="VALUE">
                          <block type="lists_select_item" id="iPwd">
                            <value name="LIST">
                              <block type="lexical_variable_get" id="gu4">
                                <field name="VAR">usuario</field>
                              </block>
                            </value>
                            <value name="NUM">
                              <block type="math_number" id="nPwd">
                                <field name="NUM">2</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="lexical_variable_set" id="setE1">
                            <field name="VAR">global emailEncontrado</field>
                            <value name="VALUE">
                              <block type="lists_select_item" id="iMail">
                                <value name="LIST">
                                  <block type="lexical_variable_get" id="gu5">
                                    <field name="VAR">usuario</field>
                                  </block>
                                </value>
                                <value name="NUM">
                                  <block type="math_number" id="nMail">
                                    <field name="NUM">4</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </statement>
                <next>
                  <block type="controls_if" id="ifHay">
                    <mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="text_isEmpty" id="eClave">
                        <value name="VALUE">
                          <block type="lexical_variable_get" id="gClave2">
                            <field name="VAR">global claveEncontrada</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="component_method" id="al3">
                        <mutation component_type="Notifier" method_name="ShowAlert" is_generic="false" instance_name="Notificador">
                          <arg name="notice"></arg>
                        </mutation>
                        <field name="COMPONENT_SELECTOR">Notificador</field>
                        <value name="ARG0">
                          <block type="text" id="m3">
                            <field name="TEXT">No hay un usuario con ese email</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="component_set_get" id="setData">
                        <mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="Correo1"></mutation>
                        <field name="COMPONENT_SELECTOR">Correo1</field>
                        <field name="PROP">DataUri</field>
                        <value name="VALUE">
                          <block type="text_join" id="joinMail">
                            <mutation items="4"></mutation>
                            <value name="ADD0">
                              <block type="text" id="tm1">
                                <field name="TEXT">mailto:</field>
                              </block>
                            </value>
                            <value name="ADD1">
                              <block type="lexical_variable_get" id="gEm2">
                                <field name="VAR">global emailEncontrado</field>
                              </block>
                            </value>
                            <value name="ADD2">
                              <block type="text" id="tm2">
                                <field name="TEXT">?subject=Clave Gestor de Contratos&amp;body=Su clave es: </field>
                              </block>
                            </value>
                            <value name="ADD3">
                              <block type="lexical_variable_get" id="gCl3">
                                <field name="VAR">global claveEncontrada</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="component_method" id="startMail">
                            <mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="Correo1"></mutation>
                            <field name="COMPONENT_SELECTOR">Correo1</field>
                            <next>
                              <block type="component_method" id="al4">
                                <mutation component_type="Notifier" method_name="ShowAlert" is_generic="false" instance_name="Notificador">
                                  <arg name="notice"></arg>
                                </mutation>
                                <field name="COMPONENT_SELECTOR">Notificador</field>
                                <value name="ARG0">
                                  <block type="text" id="m4">
                                    <field name="TEXT">Se abrio el correo para enviar su clave</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
